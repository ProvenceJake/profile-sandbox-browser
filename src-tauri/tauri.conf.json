{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Profile Harbor",
  "version": "0.11.0",
  "identifier": "dev.provencejake.profileharbor",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "capabilities": [
        {
          "identifier": "manager",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "allow-operate"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
